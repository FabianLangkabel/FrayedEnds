class Integrals3D:
    def __init__(self, mp: MadnessProcess3D) -> None: ...

    def override_numerical_parameters(self, truncation_tol: float, coulomb_lo: float, coulomb_eps: float) -> None: ...

    def get_numerical_parameters(self) -> list[tuple[str, float]]: ...

    def compute_overlap_integrals(self, all_orbs: Sequence[SavedFct3D], other: Sequence[SavedFct3D]) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None))]: ...

    def compute_potential_integrals(self, all_orbs: Sequence[SavedFct3D], potential: SavedFct3D) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None))]: ...

    def compute_kinetic_integrals(self, all_orbs: Sequence[SavedFct3D]) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None))]: ...

    def compute_two_body_integrals(self, all_orbs: Sequence[SavedFct3D]) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None, None, None))]: ...

    def compute_frozen_core_interaction(self, fr_c_orbs: Sequence[SavedFct3D], a_orbs: Sequence[SavedFct3D]) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None))]: ...

    def compute_effective_hamiltonian(self, core_orbitals: Sequence[SavedFct3D], active_orbitals: Sequence[SavedFct3D], potential: SavedFct3D, energy_offset: float) -> tuple: ...

    def transform(self, orbitals: Sequence[SavedFct3D], matrix: Annotated[NDArray[numpy.float64], dict(shape=(None, None))]) -> list[SavedFct3D]: ...

    def project_out(self, kernel: Sequence[SavedFct3D], target: Sequence[SavedFct3D]) -> list[SavedFct3D]: ...

    def project_on(self, kernel: Sequence[SavedFct3D], target: Sequence[SavedFct3D]) -> list[SavedFct3D]: ...

    def normalize(self, all_orbs: Sequence[SavedFct3D]) -> list[SavedFct3D]: ...

    def orthonormalize(self, all_orbs: Sequence[SavedFct3D], method: str, rr_thresh: float, occupations: Annotated[NDArray[numpy.float64], dict(shape=(None,))], degeneracy_tol: float = 1e-06) -> list[SavedFct3D]: ...

    def compute_electron_density(self, core_orbitals: Sequence[SavedFct3D], active_orbitals: Sequence[SavedFct3D], rdm1: Annotated[NDArray[numpy.float64], dict(shape=(None, None))]) -> SavedFct3D: ...

