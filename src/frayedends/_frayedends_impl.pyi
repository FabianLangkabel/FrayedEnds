class Optimization3D:
    def __init__(self, mp: MadnessProcess3D) -> None: ...

    def override_numerical_parameters(self, truncation_tol: float, coulomb_lo: float, coulomb_eps: float, BSH_lo: float, BSH_eps: float) -> None: ...

    def get_numerical_parameters(self) -> list[tuple[str, float]]: ...

    def give_initial_orbitals(self, fr_core_orbs: Sequence[SavedFct3D], act_orbs: Sequence[SavedFct3D]) -> None: ...

    def give_rdm_and_rotate_orbitals(self, one_rdms: Annotated[NDArray[numpy.float64], dict(shape=(None, None))], two_rdms: Annotated[NDArray[numpy.float64], dict(shape=(None, None, None, None))]) -> None: ...

    def give_rdm_hcb(self, one_rdms: Annotated[NDArray[numpy.float64], dict(shape=(None, None))], two_rdms: Annotated[NDArray[numpy.float64], dict(shape=(None, None))]) -> None: ...

    def give_potential_and_repulsion(self, potential: SavedFct3D, nuclear_repulsion: float) -> None: ...

    def calculate_all_integrals(self, update_aa: bool = True) -> None: ...

    def calculate_energies(self) -> None: ...

    def calculate_energies_hcb(self) -> None: ...

    def calculate_lagrange_multiplier(self) -> None: ...

    def calculate_lagrange_multiplier_hcb(self) -> None: ...

    def calculate_lagrange_multiplier_element_as_as(self, z: int, i: int) -> float: ...

    def calculate_lagrange_multiplier_element_as_core(self, z: int, i: int) -> float: ...

    def calculate_lagrange_multiplier_hcb_element_as_as(self, z: int, i: int) -> float: ...

    def calculate_lagrange_multiplier_hcb_element_as_core(self, z: int, i: int) -> float: ...

    def optimize_orbitals(self, optimization_thresh: float, NO_occupation_thresh: float, maxiter: int, refine_c: bool, use_hcb: bool, use_nonlinear_solver: bool = False) -> bool: ...

    def get_all_active_orbital_updates(self, orbital_indices_for_update: Sequence[int]) -> list[real_function_3d]: ...

    def get_all_active_orbital_updates_hcb(self, orbital_indices_for_update: Sequence[int]) -> list[real_function_3d]: ...

    def rotate_orbitals_back(self) -> None: ...

    def set_orthonormalization_method(self, method: str, degeneracy_tol: float = 0.001) -> None: ...

    def get_orbitals(self) -> tuple[list[SavedFct3D], list[SavedFct3D]]: ...

    def get_effective_hamiltonian(self) -> tuple: ...

    def get_c(self) -> float: ...

