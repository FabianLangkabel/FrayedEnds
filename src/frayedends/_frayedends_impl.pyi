class MadnessProcess3D:
    def __init__(self, L: float, k: int, thresh: float, initial_level: int, truncate_mode: int, refine: bool, n_threads: int) -> None: ...

    def get_function_defaults(self) -> dict: ...

    def update_function_defaults(self) -> None: ...

    def change_nthreads(self, n_threads: int) -> None: ...

    def loadfct(self, Sf: SavedFct3D) -> real_function_3d: ...

    def loadfct_from_m_file(self, filename: str) -> real_function_3d: ...

    def save_to_m_file(self, filename: str, Sf: SavedFct3D) -> None: ...

    def load_savedfct_from_m_file(self, filename: str) -> SavedFct3D: ...

    def plot(self, filename: str, f: SavedFct3D, axis: str, datapoints: int) -> None: ...

    def plane_plot(self, filename: str, f: SavedFct3D, plane: str, zoom: float, datapoints: int, origin: Sequence[float]) -> None: ...

    def cube_plot(self, filename: str, f: SavedFct3D, molecule: MolecularGeometry, zoom: float, datapoints: int, origin: Sequence[float]) -> None: ...

    def evaluate(self, orbitals: Sequence[SavedFct3D], flat_points: Sequence[float]) -> list[list[float]]: ...

    @property
    def L(self) -> float: ...

    @L.setter
    def L(self, arg: float, /) -> None: ...

    @property
    def k(self) -> int: ...

    @k.setter
    def k(self, arg: int, /) -> None: ...

    @property
    def thresh(self) -> float: ...

    @thresh.setter
    def thresh(self, arg: float, /) -> None: ...

    @property
    def initial_level(self) -> int: ...

    @initial_level.setter
    def initial_level(self, arg: int, /) -> None: ...

    @property
    def truncate_mode(self) -> int: ...

    @truncate_mode.setter
    def truncate_mode(self, arg: int, /) -> None: ...

    @property
    def refine(self) -> bool: ...

    @refine.setter
    def refine(self, arg: bool, /) -> None: ...

    @property
    def n_threads(self) -> int: ...

    @n_threads.setter
    def n_threads(self, arg: int, /) -> None: ...

